<launch>
  <arg name="api_mode" default="2" description="options: 0(All), 1(Without 2025/09 EOL API), 2(Without 2025/12 EOL API)"/>

  <arg name="rosbridge_enabled" default="false"/>
  <arg name="rosbridge_respawn" default="true"/>
  <arg name="rosbridge_max_message_size" default="10000000"/>

  <arg name="use_control_command_gate" default="false"/>
  <arg name="node_emergency_stop" default="/control/vehicle_cmd_gate"/>
  <arg name="param_emergency_stop" default="check_external_emergency_heartbeat"/>
  <arg name="node_max_velocity" default="/planning/scenario_planning/velocity_smoother"/>
  <arg name="param_max_velocity" default="max_velocity"/>

  <group if="$(var rosbridge_enabled)">
    <include file="$(find-pkg-share rosbridge_server)/launch/rosbridge_websocket_launch.xml">
      <arg name="respawn" value="$(var rosbridge_respawn)"/>
      <arg name="max_message_size" value="$(var rosbridge_max_message_size)"/>
    </include>
  </group>

  <!-- Single merged TIER IV API host node (AWAPI-relative topics under /awapi) -->
  <group>
    <push-ros-namespace namespace="awapi"/>
    <node pkg="tier4_autoware_api_host" exec="tier4_api_host_node"
          name="tier4_api_host" output="screen">
      <param from="$(find-pkg-share tier4_autoware_api_host)/config/tier4_api_host.param.yaml"/>
      <param from="$(find-pkg-share tier4_autoware_api_host)/config/plugins/awapi.param.yaml"/>
      <param from="$(find-pkg-share tier4_autoware_api_host)/config/plugins/external_api.param.yaml"/>
      <param from="$(find-pkg-share tier4_autoware_api_host)/config/plugins/internal_api.param.yaml"/>
      <param from="$(find-pkg-share tier4_autoware_api_host)/config/plugins/extension_api.param.yaml"/>
      <param from="$(find-pkg-share tier4_autoware_api_host)/config/plugins/deprecated_api.param.yaml"/>
      <param name="api_mode" value="$(var api_mode)"/>
      <param name="use_control_command_gate" value="$(var use_control_command_gate)"/>
      <param name="node/emergency_stop" value="$(var node_emergency_stop)"/>
      <param name="param/emergency_stop" value="$(var param_emergency_stop)"/>
      <param name="node/max_velocity" value="$(var node_max_velocity)"/>
      <param name="param/max_velocity" value="$(var param_max_velocity)"/>

      <!-- AWAPI I/O remaps (mirrors awapi_awiv_adapter.launch.xml) -->
      <remap from="input/max_velocity" to="vehicle/put/velocity"/>
      <remap from="input/temporary_stop" to="vehicle/put/stop"/>
      <remap from="output/vehicle_status" to="vehicle/get/status"/>
      <remap from="output/autoware_status" to="autoware/get/status"/>
      <remap from="output/lane_change_status" to="lane_change/get/status"/>
      <remap from="output/obstacle_avoid_status" to="object_avoidance/get/status"/>
      <remap from="output/max_velocity" to="/planning/scenario_planning/max_velocity_default"/>
      <remap from="output/v2x_command" to="/awapi/tmp/infrastructure_commands"/>
      <remap from="output/v2x_state" to="/awapi/tmp/virtual_traffic_light_states"/>
    </node>
  </group>

  <!-- Path distance calculator (feeds extension route_distance plugin) -->
  <group>
    <push-ros-namespace namespace="tier4_api"/>
    <node pkg="autoware_path_distance_calculator" exec="autoware_path_distance_calculator_node"
          name="path_distance_calculator" namespace="utils" output="screen">
      <remap from="~/input/path" to="/planning/scenario_planning/lane_driving/behavior_planning/path"/>
      <remap from="~/output/distance" to="/tier4_api/utils/path_distance_calculator/distance"/>
    </node>
  </group>
</launch>
