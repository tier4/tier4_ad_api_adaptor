<launch>
  <!-- For API EOL information, see https://github.com/tier4/tier4_ad_api_adaptor -->
  <arg name="api_mode" default="2" description="options: 0(All), 1(Without 2025/09 EOL API), 2(Without 2025/12 EOL API)"/>
  <arg name="launch_api_0_4_3" default="false" description="Launch APIs with an EOL of v0.4.3."/>
  <arg name="launch_api_0_4_4" default="false" description="Launch APIs with an EOL of v0.4.4."/>

  <!-- rosbridge options -->
  <arg name="rosbridge_enabled" default="false"/>
  <arg name="rosbridge_respawn" default="true"/>
  <arg name="rosbridge_max_message_size" default="10000000"/>

  <!-- rosbridge -->
  <group if="$(var rosbridge_enabled)">
    <include file="$(find-pkg-share rosbridge_server)/launch/rosbridge_websocket_launch.xml">
      <arg name="respawn" value="$(var rosbridge_respawn)"/>
      <arg name="max_message_size" value="$(var rosbridge_max_message_size)"/>
    </include>
  </group>

  <!-- awapi -->
  <group>
    <include file="$(find-pkg-share awapi_awiv_adapter)/launch/awapi_awiv_adapter.launch.xml">
      <arg name="api_mode" value="$(var api_mode)"/>
    </include>
  </group>

  <!-- external api adaptor -->
  <group>
    <push-ros-namespace namespace="autoware_api"/>
    <include file="$(find-pkg-share autoware_iv_external_api_adaptor)/launch/external_api_adaptor.launch.py">
      <arg name="launch_api_0_4_3" value="$(var launch_api_0_4_3)"/>
      <arg name="launch_api_0_4_4" value="$(var launch_api_0_4_4)"/>
    </include>
  </group>

  <!-- external api adaptor (RTC controller) -->
  <group>
    <push-ros-namespace namespace="autoware_api/external/rtc_controller"/>
    <node_container pkg="rclcpp_components" exec="component_container_mt" name="container" namespace="" ros_args="--log-level autoware_api.external.rtc_controller.container:=warn">
      <composable_node pkg="autoware_iv_external_api_adaptor" plugin="external_api::RTCController" name="node"/>
    </node_container>
  </group>

  <!-- internal api adaptor -->
  <group>
    <push-ros-namespace namespace="autoware_api"/>
    <include file="$(find-pkg-share autoware_iv_internal_api_adaptor)/launch/internal_api_relay.launch.xml" if="$(var launch_api_0_4_3)"/>
    <include file="$(find-pkg-share autoware_iv_internal_api_adaptor)/launch/internal_api_adaptor.launch.py">
      <arg name="launch_api_0_4_3" value="$(var launch_api_0_4_3)"/>
    </include>
  </group>

  <!-- tier4 autoware api extension -->
  <group>
    <include file="$(find-pkg-share tier4_autoware_api_extension)/launch/tier4_autoware_api_extension.launch.xml">
      <arg name="launch_api_0_4_3" value="$(var launch_api_0_4_3)"/>
    </include>
  </group>

  <!-- tier4 deprecated api adapter -->
  <group>
    <include file="$(find-pkg-share tier4_deprecated_api_adapter)/launch/tier4_deprecated_api_adapter.launch.xml">
      <arg name="api_mode" value="$(var api_mode)"/>
    </include>
  </group>
</launch>
