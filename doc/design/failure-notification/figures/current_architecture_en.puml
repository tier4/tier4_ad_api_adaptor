@startuml current_architecture_en
!theme plain
skinparam backgroundColor white
skinparam componentStyle rectangle
skinparam packageStyle rectangle

title Current Architecture: Failure Information Flow

package "ADK (Autoware)" {
  component "Diag Nodes" as DiagNodes
  component "diagnostic_graph\n_aggregator" as Aggregator
  component "default_adapi\n(DiagnosticsNode)" as ADAPI

  DiagNodes -right-> Aggregator : DiagnosticArray
  Aggregator -right-> ADAPI : DiagGraphStruct\nDiagGraphStatus
}

package "External Systems" {
  component "MOT\n(In-vehicle Operator\nMonitor)" as MOT
  file "mrm_messages.json\n(situation / solution)" as JSON
}

ADAPI -down-> MOT : /api/system/diagnostics/struct\n/api/system/diagnostics/status
JSON -left-> MOT : Lookup by\ndiag path

note bottom of JSON
  Stored locally on MOT side
  Managed separately from ADK
  Risk of version mismatch
end note

note bottom of MOT
  Users: In-vehicle operators
  Expansion to remote systems
  is a challenge
end note
@enduml
