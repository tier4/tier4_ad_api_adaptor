  <depend>tier4_auto_msgs_converter</depend>
  <depend>tier4_control_msgs</depend>
  <depend>tier4_external_api_msgs</depend>
  <depend>tier4_perception_msgs</depend>
  <depend>tier4_planning_msgs</depend>
